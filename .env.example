# ---------------------------------------------------------------------------
# Server-side only (used by the Vercel function in /api/contact.ts).
# Set these in Vercel → Project → Settings → Environment Variables.
# NEVER prefix these with VITE_ — that would expose them to the browser.
# ---------------------------------------------------------------------------

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives contact-form messages
CONTACT_TO_EMAIL=sagargurjar301@gmail.com

# Verified sender. For testing you can use: Portfolio <onboarding@resend.dev>
CONTACT_FROM_EMAIL=

# Optional: comma-separated list of origins allowed to call /api/contact.
# Defaults to the same host that serves the function.
# ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ---------------------------------------------------------------------------
# Build-time (optional)
# ---------------------------------------------------------------------------

# Canonical site URL used for canonical/OG tags and sitemap.xml.
# Prefer setting seo.siteUrl in src/data/portfolio.ts. If both are empty,
# Vercel's production domain (VERCEL_PROJECT_PRODUCTION_URL) is used.
# SITE_URL=https://your-domain.com
